# ClipFlow Backend Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./clipflow.db

# File storage path
STORAGE_PATH=./storage

# FFmpeg paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=2048

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# --- Local ML Settings (no API keys needed!) ---

# Whisper model size: tiny, base, small, medium, large-v3
# Larger = more accurate but slower. "base" is good for most content.
WHISPER_MODEL_SIZE=base

# Similarity threshold for duplicate detection (0.0 to 1.0)
# Higher = stricter matching. 0.78 works well for most content.
SIMILARITY_THRESHOLD=0.78

# --- Optional API Keys (not required, local models used by default) ---

# HuggingFace token for WhisperX speaker diarization (free account)
# Get one at: https://huggingface.co/settings/tokens
# Without this, transcription works but won't identify different speakers
HF_TOKEN=

# These are OPTIONAL - only needed if you prefer cloud APIs over local models
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
